// Copy to Config/Local.xcconfig (gitignored) to override defaults.
//
// Unique bundle ID for your Apple Developer team (required for device installs):
// PRODUCT_BUNDLE_IDENTIFIER = com.yourname.spendflow
//
// Production API (default):
//   https://spendflow-api.stockpulse.win/api/v1
//
// Local backend example:
// API_BASE_URL = http:/$()/127.0.0.1:4000/api/v1
//
// Web OAuth client — must match backend GOOGLE_CLIENT_ID (see containers/.env)
// GOOGLE_SERVER_CLIENT_ID = your-web-client-id.apps.googleusercontent.com
//
// After changing bundle ID, create a matching iOS OAuth client in Google Cloud and
// replace SpendFlow/Resources/GoogleService-Info.plist + Info.plist URL scheme.
