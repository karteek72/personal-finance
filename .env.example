# SpendFlow — single environment file (repo root)
# Copy to .env and fill in secrets. All apps read this file:
#   backend, ui (Next.js), Podman compose (containers/compose.yaml)

# --- App URLs (local dev) ---
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
UI_APP_URL=http://localhost:3002
CORS_ORIGIN=http://localhost:3002
CORS_ORIGINS=http://localhost:3002,http://localhost:3000,http://127.0.0.1:3002

# --- Web UI (Next.js — must be NEXT_PUBLIC_*) ---
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3002
NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Database & Redis (host dev: npm run dev / scripts/podman/dev.sh) ---
POSTGRES_USER=spendflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=spendflow
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
DATABASE_URL=postgresql://spendflow:change-me@localhost:5433/spendflow
REDIS_URL=redis://localhost:6380

# Container deploy overrides DATABASE_URL/REDIS_URL in scripts/podman/deploy.sh
# (in-network postgres:5432 and redis:6379). Keep POSTGRES_PASSWORD in sync.

# --- Auth ---
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
GOOGLE_CLIENT_ID=
GOOGLE_SECRET_KEY=
# GOOGLE_CLIENT_IDS=ios-client-id.apps.googleusercontent.com
AUTH_ALLOW_DEV_USER=true

# Token encryption (required when NODE_ENV=production in containers)
# openssl rand -hex 32
# ENCRYPTION_KEY=

# --- Plaid ---
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions,liabilities
PLAID_COUNTRY_CODES=US
# PLAID_REDIRECT_URI=https://your-public-ui-origin/plaid/oauth
# PLAID_OAUTH_ENABLED=true

# --- Teller (banking & credit cards) ---
# TELLER_APPLICATION_ID=app_xxxx
# TELLER_ENV=sandbox
# TELLER_CERT_PATH=/path/to/cert.pem
# TELLER_KEY_PATH=/path/to/key.pem

# --- SnapTrade (brokerage) ---
# SNAPTRADE_CLIENT_ID=
# SNAPTRADE_CONSUMER_KEY=
# SNAPTRADE_REDIRECT_URI=http://localhost:3002/accounts/snaptrade/callback
# Personal keys allow one SnapTrade user — reuse your registered user in dev:
# SNAPTRADE_SHARED_USER_ID=your-snaptrade-user-id
# SNAPTRADE_SHARED_USER_SECRET=your-snaptrade-user-secret

# --- Statement import limits (optional) ---
# IMPORT_MAX_FILES=12
# IMPORT_MAX_FILE_BYTES=10485760
# IMPORT_MAX_BATCH_BYTES=125829120
# IMPORT_BLOB_RETENTION_HOURS=24

# --- Container deploy only (optional — see containers/deploy.env.example) ---
# SPENDFLOW_HOST=0.0.0.0
# SPENDFLOW_UI_PORT=3005
# SPENDFLOW_API_PORT=4000
# SPENDFLOW_UI_PUBLIC_URL=http://localhost:3005
# SPENDFLOW_API_PUBLIC_URL=http://localhost:4000
