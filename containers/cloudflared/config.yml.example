# Example ingress for the host cloudflared systemd service (not Podman).
# Edit your live config (often /etc/cloudflared/config.yml) and restart:
#   sudo systemctl restart cloudflared
#
# Containers publish on SPENDFLOW_HOST from deploy.env (default 192.168.68.100).

tunnel: <your-tunnel-id-or-name>
credentials-file: /etc/cloudflared/<tunnel-id>.json

ingress:
  - hostname: spendflow.stockpulse.win
    service: http://192.168.68.100:3000
  - hostname: spendflow-api.stockpulse.win
    service: http://192.168.68.100:4000
  - service: http_status:404
