# Copy to containers/deploy.env and adjust for your host.
# Used by scripts/podman/build.sh and deploy.sh

# Container image tag (default latest). Override per run: --version 1.2.3
# SPENDFLOW_IMAGE_TAG=latest

# LAN bind address — 0.0.0.0 works on any host; set your LAN IP only if you want a fixed value in logs/CORS hints.
# deploy.sh falls back to 0.0.0.0 if SPENDFLOW_HOST is not assigned on this machine.
SPENDFLOW_HOST=0.0.0.0
SPENDFLOW_UI_PORT=3005
SPENDFLOW_API_PORT=4000

# Public HTTPS URLs (Cloudflare DNS → tunnel or proxy)
SPENDFLOW_UI_PUBLIC_URL=https://spendflow.stockpulse.win
SPENDFLOW_API_PUBLIC_URL=https://spendflow-api.stockpulse.win

# LAN HTTP URLs (included in API CORS) — use your host IP + published ports below
SPENDFLOW_UI_LAN_URL=http://192.168.68.100:3005
SPENDFLOW_API_LAN_URL=http://192.168.68.100:4000

# Comma-separated extra CORS origins (scripts also auto-add public + LAN URLs)
CORS_ORIGINS=https://spendflow.stockpulse.win,http://192.168.68.100:3005,http://localhost:3005

# Baked into the UI image at build time (use public API for iPhone / internet)
NEXT_PUBLIC_API_URL=https://spendflow-api.stockpulse.win/api/v1
NEXT_PUBLIC_APP_URL=https://spendflow.stockpulse.win
NEXT_PUBLIC_USE_MOCKS=false

# UI build: public = bake HTTPS hostnames for Cloudflare tunnel (required for spendflow.stockpulse.win).
# lan = bake LAN IP URLs only (API calls fail from HTTPS UI due to mixed content).
# When SPENDFLOW_UI_PUBLIC_URL is https://, public is inferred even if this is unset.
SPENDFLOW_BUILD_TARGET=public

# Stop npm dev processes on API/UI ports before starting containers
SPENDFLOW_STOP_DEV=true

# --- Postgres / DATABASE_URL ---
# API container reads DATABASE_URL (see compose.yaml). POSTGRES_USER/PASSWORD/DB must match
# containers/.env — they are expanded when deploy.sh sources this file after .env.
# Hostname `postgres` is the bundled compose service on spendflow-net (internal port 5432).
# deploy.sh always starts bundled postgres unless SPENDFLOW_EXTERNAL_POSTGRES=true.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
# Must match POSTGRES_* in containers/.env (password must be identical).
# deploy.sh expands this when sourcing; for raw `podman compose`, use literal credentials.
DATABASE_URL=postgresql://spendflow:change-me@postgres:5432/spendflow

# Redis (BullMQ) — bundled compose service on spendflow-net (volume spendflow-redisdata)
REDIS_URL=redis://redis:6379

# Bundled postgres is the default (compose profile bundled-db).
# Set SPENDFLOW_EXTERNAL_POSTGRES=true only when Postgres runs outside this compose stack.
# SPENDFLOW_EXTERNAL_POSTGRES=false
