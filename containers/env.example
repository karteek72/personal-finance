# Copy to containers/.env — secrets and backend config for compose.
# You can also symlink ../.env if you keep a single file at repo root.

NODE_ENV=production

# Postgres (must match compose postgres service)
POSTGRES_USER=spendflow
POSTGRES_PASSWORD=change-me
POSTGRES_DB=spendflow
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380

# Host dev (npm run dev / scripts/podman/dev.sh) — localhost ports above
# REDIS_HOST_PORT is the host bind port; containers still use redis:6379 on spendflow-net.
DATABASE_URL=postgresql://spendflow:change-me@localhost:5433/spendflow
REDIS_URL=redis://localhost:6380

# Container deploy overrides DATABASE_URL/REDIS_URL via deploy.sh (in-network postgres/redis
# hostnames). localhost URLs below are for npm run dev on the host only.

# Plaid
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions
PLAID_COUNTRY_CODES=US
# Use your public UI origin for OAuth return
PLAID_REDIRECT_URI=https://spendflow.stockpulse.win/plaid/oauth

# Auth — required in production
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
GOOGLE_CLIENT_ID=
GOOGLE_SECRET_KEY=
AUTH_ALLOW_DEV_USER=false

# Required for container deploy (compose sets NODE_ENV=production).
# Generate once and keep stable — changing it invalidates stored Plaid tokens.
# ENCRYPTION_KEY=
# openssl rand -hex 32

# Statement import upload limits (optional)
# IMPORT_MAX_FILES=10
# IMPORT_MAX_FILE_BYTES=10485760
# IMPORT_MAX_BATCH_BYTES=52428800
# IMPORT_BLOB_RETENTION_HOURS=24

# Google Sign-In
# GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_IDS=your-ios-client-id.apps.googleusercontent.com
