{
  "name": "spendflow-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "import:statements": "tsx scripts/import-statements.ts",
    "db:assign-legacy": "tsx scripts/assign-legacy-data.ts",
    "db:gen-mock": "tsx scripts/generate-mock-dataset.ts",
    "db:seed": "tsx scripts/seed-mock-data.ts",
    "db:wipe-user": "tsx scripts/wipe-user-financial-data.ts",
    "seed:mock": "tsx scripts/seed-mock-data.ts",
    "test:import": "tsx --test src/services/import/__tests__/*.test.ts",
    "test:export": "tsx --test src/services/__tests__/export-user-data.test.ts",
    "test:tenant": "tsx scripts/check-transaction-scoping.ts && tsx --test src/services/__tests__/tenant-isolation.test.ts",
    "test:unit": "tsx --test src/services/__tests__/*.test.ts src/lib/__tests__/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/multipart": "^9.4.0",
    "bullmq": "^5.34.8",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "fast-xml-parser": "^4.5.1",
    "fastify": "^5.2.1",
    "google-auth-library": "^10.6.2",
    "ioredis": "^5.4.2",
    "jose": "^6.2.3",
    "pino": "^9.6.0",
    "plaid": "^30.0.0",
    "postgres": "^3.4.5",
    "snaptrade-typescript-sdk": "^9.0.200",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.19",
    "drizzle-kit": "^0.30.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "yaml": "^2.9.0"
  }
}
