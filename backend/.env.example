NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3002

# Plaid (production)
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=production
PLAID_PRODUCTS=transactions,liabilities
PLAID_COUNTRY_CODES=US
# Register this exact URI in Plaid Dashboard → Allowed redirect URIs
# PLAID_REDIRECT_URI=http://localhost:3000/plaid/oauth

# App
APP_URL=http://localhost:4000
UI_APP_URL=http://localhost:3002

# Token encryption (optional in dev — uses insecure default if unset)
# ENCRYPTION_KEY=

# Job queue (optional in dev — webhooks sync inline when unset)
REDIS_URL=redis://localhost:6379

# Auth (Google sign-in + JWT for API)
# JWT_SECRET=change-me-to-a-long-random-string
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# AUTH_ALLOW_DEV_USER=true
